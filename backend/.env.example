# Copy to .env and adjust. Never commit .env.
APP_NAME=TruthLens
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# LLM (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# Embeddings (Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=128

# Qdrant (start with: docker compose up -d qdrant)
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=truthlens_knowledge

# Knowledge-base retrieval (RAG)
RAG_TOP_K=5
RAG_MIN_SCORE=0.3

# Web Agent (Tavily MCP). Get a key at https://app.tavily.com
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
