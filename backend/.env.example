# Copy to .env and adjust. Never commit .env.
APP_NAME=TruthLens
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# LLM (Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# Embeddings (Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=128

# Qdrant (start with: docker compose up -d qdrant)
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=truthlens_knowledge

# Knowledge-base retrieval (RAG)
RAG_TOP_K=5
RAG_MIN_SCORE=0.3

# Web Agent (Tavily MCP). Get a key at https://app.tavily.com
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# Research Agent (Semantic Scholar, OpenAlex, Europe PMC). Keys are optional:
# without them, Semantic Scholar often rate-limits (HTTP 429) and OpenAlex uses a
# small shared daily budget. Europe PMC needs no key.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
RESEARCH_MAX_API_CALLS=6
RESEARCH_MAX_ITERATIONS=5
RESEARCH_RESULTS_PER_CALL=5
RESEARCH_HTTP_TIMEOUT_SECONDS=15

# Fact-Checking Agent budgets (per user message)
FACT_CHECK_MAX_EXTERNAL_RUNS=2
FACT_CHECK_MAX_RAG_CALLS=2
FACT_CHECK_MAX_RESEARCH_ITERATIONS=3
FACT_CHECK_MAX_SYNTHESIS_EVIDENCE=20
FACT_CHECK_HISTORY_TURNS=6

# PostgreSQL (docker compose up -d postgres). Choose your own password.
POSTGRES_USER=truthlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=truthlens
DATABASE_URL=postgresql+psycopg://truthlens:change-me@localhost:5433/truthlens
# Optional: enables the PostgreSQL integration tests (they create/drop their own tables).
TEST_DATABASE_URL=postgresql+psycopg://truthlens:change-me@localhost:5433/truthlens_test
